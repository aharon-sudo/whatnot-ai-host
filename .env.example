# xAI Grok Voice Agent
XAI_API_KEY=

# OBS WebSocket (Tools -> WebSocket Server Settings in OBS)
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# OBS scene/source names (must match your OBS scene collection exactly)
OBS_SCENE_NAME=Auction
OBS_IMAGE_SOURCE_NAME=ProductImage
OBS_AUDIO_SOURCE_NAME=AIHostVoice

# Playwright persisted login
WHATNOT_STORAGE_STATE_PATH=./whatnot_storage_state.json
WHATNOT_DASHBOARD_URL=

# Alerting when the failsafe trips (pick one; Slack incoming webhook is simplest to start)
ALERT_WEBHOOK_URL=

# Path to the ordered inventory file for this stream
INVENTORY_PATH=./inventory/example_inventory.json
